# JARVIS .gitignore
# Python and project-specific files to exclude from version control

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# JARVIS Sensitive Data (CRITICAL)
data/voiceprint.encrypted
data/enrollment_samples/
logs/access.log

# PyTorch & Models
models/speech_recognition/vosk-model-*
models/speaker_verification/
*.pth
*.pt

# Temporary files
*.tmp
*.temp
.cache
*.cache

# Environment variables (SECURITY)
.env
.env.local
.env.*.local
.env.*.prod

# Test outputs
.pytest_cache/
.coverage
htmlcov/

# Package managers
poetry.lock
Pipfile.lock

# OS
Thumbs.db
.directory
